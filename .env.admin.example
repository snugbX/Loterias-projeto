# Modelo sem credenciais. Preencha somente em um arquivo local .env.admin ignorado pelo Git.
# Session pooler, copiado do painel Connect do Supabase; senha deve estar codificada na URL.
DATABASE_ADMIN_URL=
DATABASE_APP_PASSWORD=
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=
# Chave Fernet gerada localmente; guarde uma copia segura separada dos backups.
LOTTERY_BACKUP_KEY=
# Opcional: conexao do usuario restrito para executar o comando check.
DATABASE_URL=
